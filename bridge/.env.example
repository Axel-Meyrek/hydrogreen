# Copia este archivo como .env y pon los valores reales (Manuel te los manda en privado).
# Nunca lo subas al Drive ni al grupo, y no lo incluyas en tu zip.

# EMQX Cloud, usuario bridge-service (TLS, puerto 8883)
MQTT_URL=mqtts://<host>:8883
MQTT_USER=bridge-service
MQTT_PASS=

# Supabase (Project Settings → API). Se llama igual que en web/ para usar una sola URL.
NEXT_PUBLIC_SUPABASE_URL=
# Service role: salta RLS. Solo en el puente y en el servidor de web/, nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# El puente llama a POST /api/ai/run cada 15 min con el header x-ai-secret
AI_RUN_URL=http://localhost:3000/api/ai/run
AI_RUN_SECRET=
