# Copia este archivo como .env.local y pon los valores reales. Nunca lo subas al Drive ni al grupo.

# Cliente del navegador (Supabase → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor: nunca con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=

# El puente llama a /api/ai/run con este secreto en el header x-ai-secret (mismo valor que en bridge/.env)
AI_RUN_URL=http://localhost:3000/api/ai/run
AI_RUN_SECRET=

# true = datos simulados (respaldo para la demo). Hasta la fase 2 solo existe el modo demo.
NEXT_PUBLIC_DEMO_MODE=true
